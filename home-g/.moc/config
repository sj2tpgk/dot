# Note: needs ffmpeg4.4 is required for many audio files

StartInMusicDir = no

# Note: JACK causes continuous CPU usage when idle (music stopped). So removing it here (the default list is JACK:ALSA:OSS)
SoundDriver = ALSA

Theme=${HOME}/.moc/themes/black_theme_edited
Keymap = my_default_keymap

SeekTime = 4
SilentSeekTime = 60

Layout1 = directory(0,0,50%,100%):playlist(50%,0,FILL,100%)
Layout2 = directory(0,0,100%,100%):playlist(0,0,100%,100%)
Layout3 = playlist(0,0,50%,100%):directory(50%,0,FILL,100%)
CanStartInPlaylist = yes

PlaylistFullPaths = no
