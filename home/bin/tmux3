#!/bin/sh

tmpsocket=$(tr -cd 0-9 < /dev/urandom | head -c 7)
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT INT TERM

export TMUX_DEFAULT_SHELL
export TMUX_DEFAULT_COMMAND
TMUX_DEFAULT_SHELL="$(tmux show -gv default-shell)"
TMUX_DEFAULT_COMMAND="$(tmux show -gv default-command)"

# shellcheck disable=SC2016
echo '
set -g default-shell "${TMUX_DEFAULT_SHELL}"
set -g default-command "${TMUX_DEFAULT_COMMAND}"
setenv -gu TMUX_DEFAULT_SHELL
setenv -gu TMUX_DEFAULT_COMMAND

unbind-key -a
set -g prefix S-F5
bind -n F5 next-window
bind -n M-F5 new-window -c "#{pane_current_path}"

set -g status-justify right
set -g status-left ""
set -g status-position top
set -g status-right ""
set -g status-style bg=default

set -g window-status-current-format ":#I"
set -g window-status-current-style bg=black,fg=red,bold,reverse
set -g window-status-format ":#I"
set -g window-status-separator ""
set -g window-status-style bg=black,fg=red,bold
' > "$tmp"

tmux -L "$tmpsocket" -f "$tmp"
