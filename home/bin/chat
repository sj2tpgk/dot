# Notes:
# - avoid including arbitrarily large strings in command parameter (use pipe instead)
# - assume concurrent run

## Constants/variables

COLOR_TOOL=34
COLOR_REASON=35
COLOR_STAT=0

TOOL_DEFAULT_TIMEOUT=100

DATADIR=~/.cache/chat2

# name:tool description:[param=[r|o]=[a|s|n]=param description[=array param=...]]
TOOLDEF="
read:Read a file. For large files use offset (1-indexed line) and limit:path=r=s=Path to the file:offset=o=n=Starting line number (1-indexed):limit=o=n=Max lines to read
write:Write content to a file. Creates parent directories. Overwrites if exists:path=r=s=Path to the file:content=r=s=Content to write
edit:Exact text replacement in a file. oldText must match exactly. Multiple non-overlapping edits supported:path=r=s=Path to the file:edits=r=a=Edits to make=[oldText=r=s=Exact text to find and replace:newText=r=s=Replacement text]
bash:Execute a shell command. Returns stdout and stderr:command=r=s=Command to execute:timeout=o=n=Timeout in seconds (default $TOOL_DEFAULT_TIMEOUT sec)
read_image:Read image file and add to the current chat context. Works with multimodal models only:path=r=s=Path of image file
# get_time:Get current time:timezone=r=s=timezone
"

# shellcheck disable=SC2016
JQLIB='
# get reasoning chat kwargs
def reason(x):if(x and(x|length>0))then(({off:"none",on:"medium"}[x]//x)|{reasoning_effort:.,enable_thinking:(.!="none")})else{}end;
def r2:(.*100+.5|floor/100);
def shassign:(to_entries|map("\(.key)=\(.value|if(type=="object")then(tojson)else(.)end|@sh)")|join(";"));
def exptilde:(sub("^~";$ENV.HOME));
def ifs(c;v):if(c)then(v)else(empty)end;
'

Tmp=
SessionFile=
HistoryFile=
ToolApi=

## Argument parsing

default_s='Respond concisely. Use lists instead of tables. Do not use bold or italic text. When coding, prefer shorter syntax and minimal comments. When writing math expressions, avoid using tex notations and make it easy to read in plaintext. When translating, also explain non-trivial grammar/phrases/words/pronunciations. Do not add warnings about the ethics of the input or the output'; default_u=localhost:11434

flag_a=; flag_b=; flag_h=; flag_l=; flag_n=; flag_p=
opt_m=; opt_r=; opt_s=$default_s; opt_u=$default_u
opt_curlopts=
opts_i=()

show_help(){
    echo "Usage: chat2 [options ...] [prompt ...]"
    echo "       cmd | chat2 [options ...]"
    echo
    echo "Options:"
    echo "  -a, --agent            Agent mode"
    echo "  -b, --bwrap            Bubblewrap"
    echo "      --curlopts <opts>  Curl options (space-splitted)"
    echo "  -h, --help             Help"
    echo "  -l, --list             List models"
    echo "  -i, --image <image>    Image file (can be added multiple times)"
    echo "  -m, --model <model>    Model (default: not set)"
    echo "  -n, --new              New chat"
    echo "  -p, --private          Don't save history"
    echo "  -r, --reason <val>     Reasoning effort (off,none,minimal,low,on,medium,high,xhigh,on) (default: not set)"
    echo "  -s, --system <prompt>  System prompt"
    echo "  -u, --url <url>        URL of server (default: $default_u)"
}

parse_opts(){
    while [[ $# -ge 1 ]]; do
        case "$1" in
            (-[!-][!-]*)    _1=${1#?} ; shift ; set -- "-${_1%"${_1#?}"}" "-${_1#?}" "$@" ;;
            (-a|--agent)    flag_a=1  ; shift ;;
            (-b|--bwrap)    flag_b=1  ; shift ;;
            (-h|--help)     flag_h=1  ; shift ;;
            (-l|--list)     flag_l=1  ; shift ;;
            (-n|--new)      flag_n=1  ; shift ;;
            (-p|--private)  flag_p=1  ; shift ;;
            (-m|--model)    opt_m="$2"; shift 2 ;;
            (-r|--reason)   opt_r="$2"; shift 2 ;;
            (-s|--system)   opt_s="$2"; shift 2 ;;
            (-u|--url)      opt_u="$2"; shift 2 ;;
            (--curlopts)    opt_curlopts="$2"; shift 2 ;;
            (-i|--image)    opts_i+=("$2"); shift 2 ;;
            (-*) error "Bad option: $1" ;;
            (*) prompt="$*" ; break ;;
        esac
    done
}

## Functions

error(){ echo "Error: $*" >&2; exit 1; }
clean(){ rm -f "$Tmp/chat_"*; rmdir "$Tmp" 2>/dev/null; return 0; }
init(){
    check_deps
    Tmp=$(mktemp -d)
    trap clean INT TERM EXIT
    SessionFile="$Tmp/chat_session.jsonl"
    HistoryFile=$(history_path)
    if [[ "$flag_a" ]]; then ToolApi=$(parse_tools "$TOOLDEF"); fi
}

check_deps(){
    local missing
    for i in curl jq stdbuf; do
        command -v "$i" >/dev/null || missing="$missing $i"
    done
    [[ "$missing" ]] && error "command not available:$missing"
    return 0 # without this, this function returns nonzero even if the last command is "X && Y" and "Y" was not executed. note you must not omit the "0"
}

# Usage: history_path
history_path(){
    echo "$DATADIR/$(readlink -f "$PWD")/history.jsonl"
}

save_history(){
    if ! [[ "$flag_p" ]]; then
        [[ "$flag_n" ]] && rm -f "$HistoryFile"
        mkdir -p "$(dirname "$HistoryFile")"
        cat "$SessionFile" >> "$HistoryFile"
    fi
}

# Usage: parse_tools DEF
parse_tools(){
    echo "$1" | jq -Rs 'def parse:map(split("="))|{ type:"object", required:map(select(.[1]=="r")[0]), properties:map({key:.[0],value:(if(.[2]=="a")then {type:"array",items:.[4:]|join("=")[1:-1]|split(":")|parse} else {type:{s:"string",n:"number"}[.[2]],description:.[3]}end)})|from_entries };
    split("\n")|map(select(length>0 and test("^\\s*[^#]";""))|[match("(\\[[^]]+\\]|[^:])+";"g").string]|{type:"function",function:{name:.[0],description:.[1],parameters:.[2:]|parse}})'
}

### API calls

show_models(){
    local res
    # shellcheck disable=SC2086
    res=$(curl -fs -H 'Content-Type: application/json' $opt_curlopts "$opt_u"/v1/models) || error "getting model list: server error"
    jq --argjson res "$res" -nr '$res|([.data[]|([.id,.aliases[]]|.[0]+(.[1:]|if(length>0)then" (\(join(",")))"else""end))+(if(.status)then(.status.value|if(.=="loaded")then"\tL"else""end)else"\t?"end)]|join("\n"))'
    # fish config for model name completion:
    # complete -c chat -e; complete -c chat -s m -f -r -k -a '(string replace -r " [(][^)]*[)]" "" (eval (commandline -b) -l -l))'
}

# Usage: call_llm SSEFILE JSONLFILE ...
call_llm(){
    local ssefile="$1"
    shift
    jq -s --arg m "$opt_m" --arg r "$opt_r" --arg s "$opt_s" --argjson t "${ToolApi:-"[]"}" \
        "$JQLIB"'{model:$m,stream:true,tools:$t,chat_template_kwargs:reason($r),messages:[{role:"system",content:$s},.[]]}' \
        "$@" > "$Tmp/chat_req"
    # cat "$Tmp/chat_req"; exit

    # Notes:
    # - {chat_template_kwargs:{reasoning_effort:xxx}} is needed for llama-server https://github.com/ggml-org/llama.cpp/issues/15130#issuecomment-3162984669
    # - reasoning_effort for gpt-oss, enable_thinking for qwen3.6
    # - 'Content-Type: application/json' is important, otherwise the server (cpp-httplib) interprets the request body as a query string (key=val&...), which causes error in router mode

    # shellcheck disable=SC2016
    local jq_parse_sse_print="$JQLIB"'foreach (inputs|if(startswith("data: {"))then(.[6:])else(empty)end|fromjson|.choices[0]) as $y (
        {r:false,t:false,pr:false,pt:false};
        {r:$y.delta.reasoning_content,t:$y.delta.tool_calls,false,pr:.r,pt:.t};
        $y.delta as $x|. as $z|[
            ifs(((.pr|not)and .r);"\u001b['"$COLOR_REASON"'m"),
            ifs((.pr and(.r|not));"\u001b[0m\n"),
            (.t[0]|if(.)then(.function as $f|
                ($f.name|ifs(.;(ifs($z.pt;"\n")//"")+"\u001b['"$COLOR_TOOL"';1m\(.)\u001b[0;'"$COLOR_TOOL"'m ")//"")+
                ($f.arguments//"")
            )else(empty)end),
            .r // $x.content // empty,
            ifs(($y.finish_reason and .pt);"\n"),
        empty][])'

    # shellcheck disable=SC2086
    stdbuf -o0 curl -fNs -H 'Content-Type: application/json' $opt_curlopts "$opt_u"/v1/chat/completions -d @"$Tmp/chat_req" \
        | stdbuf -i0 -o0 tee "$ssefile" \
        | stdbuf -i0 -o0 jq -Rrj --unbuffered "$jq_parse_sse_print"
}

# Usage: parse_sse SSEFILE
parse_sse_message(){
    # shellcheck disable=SC2016
    local jq_parse_sse='[inputs|if(startswith("data: {"))then(.[6:])else(empty)end|fromjson] | reduce (.[].choices[0].delta) as $x ({reasoning_content:"",content:"",tool_calls:[]}; (if($x.role)then(.role=$x.role)else . end|if($x.reasoning_content)then(.reasoning_content+=$x.reasoning_content)else . end|if($x.content)then(.content+=$x.content)else . end|if($x.tool_calls)then(.tool_calls+=$x.tool_calls)else . end))|(.tool_calls|=(group_by(.index)|map((.[0]|{index,id,type})+([.[].function]|{function:{name:([.[].name]|join("")),arguments:([.[].arguments]|join(""))}})))) | if(.tool_calls|length==0)then(del(.tool_calls))else . end | {role:"assistant",content:(.reasoning_content+.content)}+(if(.tool_calls)then{tool_calls}else{}end)'
    jq -Rcr "$jq_parse_sse" "$1"
}

# Usage: parse_sse_meta SSEFILE
parse_sse_meta(){
    jq -R 'inputs|if(startswith("data: {"))then(.[6:])else(empty)end|fromjson|if(.timings)then(.)else(empty)end|{model,timings:(.timings|{cache_n,prompt_per_second,prompt_n,prompt_ms,predicted_per_second,predicted_n,predicted_ms})}' "$1"
}

build_prompt(){
    local i
    for i in "${opts_i[@]}"; do
        [[ -r "$i" ]] || error "Input file does not exist: $i"
    done
    echo -n '{"role":"user","content":['
    {
        printf %s "$prompt"
        if [ ! -t 0 ]; then
            [ "$prompt" ] && printf "\n\n"
            cat
        fi
    } | jq -Rscj '{type:"text",text:.}'
    for i in "${opts_i[@]}"; do
        # Example from docs uses content:[{type:text,..},{type:image_url,..}] form, but it seems separate message entries also work (though not using it here)
        # Note: \n in image_url is not allowed at least in llama-server (e.g. "data:image/jpeg;base64,xxx...yyy\nzzz"). Use base64's --wrap flag (or tr -d '\n') to convert to a single line string
        echo -n ,
        base64 --wrap=0 "$i" | jq -Rscj '{"type":"image_url","image_url":{"url":("data:image/jpeg;base64,"+.)}}'
    done
    echo ']}'
}

### Tool

# Note:
# - Extract args from json in chat_tool_args
# - Print tool header yourself
# - Write stuff that should be included in the next prompt to stdout, others to stderr

validate_path(){
    # -m, --canonicalize-missing   no path components need exist or be a directory
    ! [[ "$(realpath -m --relative-to "$(pwd)" "$1")" =~ ^\.\./ ]]
}

# Usage: print_tool_header NAME ARGS
print_tool_header(){
    :
    # echo -e "\e[${COLOR_TOOL};1m$1\e[0;${COLOR_TOOL}m $2" >&2
}

tool_get_date(){ # sample tool
    TZ=$(jq -r .timezone "$Tmp/chat_tool_args") date
}

tool_read(){
    local path offset limit
    eval "$(jq -r "$JQLIB"'{path:(.path|exptilde),offset,limit}|shassign' "$Tmp/chat_tool_args")"

    print_tool_header Read "$path"
    validate_path "$path" || { echo "Error: access not allowed: $path"; return; }
    [[ -r "$path" ]] || { echo "Error: file not found or is not a file: $path"; return; }

    awk -v offset="$offset" -v limit="$limit" '
        BEGIN {
            offset = match(offset, "^[0-9]+$") ? int(offset) : 1;
            limit = match(limit, "^[0-9]+$") ? int(limit) : 0;
        }
        (NR>=offset) && ((limit==0) || (NR<offset+limit)) { print }
    ' "$path"
}

tool_write(){
    local path
    eval "$(jq -r "$JQLIB"'{path:(.path|exptilde)}|shassign' "$Tmp/chat_tool_args")"

    print_tool_header Write "$path"
    validate_path "$path" || { echo "Error: access not allowed: $path"; return; }

    mkdir -p "$(dirname "$path")"
    jq -r .content "$Tmp/chat_tool_args" | tee "$path" >&2
    echo "Written to $path"
}

tool_edit(){
    local i n path
    eval "$(jq -r "$JQLIB"'{path:(.path|exptilde), n:(.edits|length)}|shassign' "$Tmp/chat_tool_args")"

    print_tool_header Edit "$path ($n edit$([[ $n -ge 2 ]] && echo s))"
    validate_path "$path" || { echo "Error: access not allowed: $path"; return; }

    jq -nrj --rawfile file "$path" --slurpfile args "$Tmp/chat_tool_args" \
        'reduce $args[0].edits[] as $e ($file; (index($e.oldText) as $p|if($p==null)then error("oldText not found: " + $e.oldText) else (.[:$p] + $e.newText + .[$p+($e.oldText|length):]) end))' > "$Tmp/chat_tool_edit_tmp"
    mv -f "$Tmp/chat_tool_edit_tmp" "$path"
    echo "Made $n edit$([[ $n -ge 2 ]] && echo s) to $path"
}

tool_bash(){
    local command timeout s
    eval "$(jq -r "$JQLIB"'{command,timeout}|shassign' "$Tmp/chat_tool_args")"

    print_tool_header Bash "$command $([[ "$timeout" =~ ^[0-9]*$ ]] && echo "(timeout ${timeout}s")"
    [[ "$timeout" =~ ^[0-9]*$ ]] || timeout="$TOOL_DEFAULT_TIMEOUT"
    if timeout "$timeout" "${ary[@]}" 2>&1; then s=$?; else s=$?; fi
    [[ "$s" -eq 124 ]] && echo "Reached timeout (${timeout}s)"
    echo "Exit status $s" >&2
}

tool_read_image(){
    local path
    eval "$(jq -r "$JQLIB"'{path:(.path|exptilde)}|shassign' "$Tmp/chat_tool_args")"

    print_tool_header ReadImage "$path"
    [[ -r "$path" ]] || { echo "Error: file not found or is not a file: $path"; return; }
    [[ "$(du -b "$path"|cut -f1)" -ge 700000 ]] && { echo "Error: image file $path is too large (is $(du -b "$path"|cut -f1) bytes, max allowed 700KB). Please downscale (be careful not to override the original image)"; return; }

    # note: this results in messages in the order of assistant (with tool_calls) -> user (with image) -> tool, but it may be invalid in some models
    {
        echo -n '{"role":"user","content":['
        jq -nrcj --arg path "$path" '{type:"text",text:("This is an image read from "+$path+" with read_image tool")}'
        echo -n ',{"type":"image_url","image_url":{"url":"data:image/jpeg;base64,'
        base64 --wrap=0 "$path"
        echo '"}}]}'
    } >> "$SessionFile"
    echo "Added image from $path to context"
}

call_tool(){
    local i n name id
    n=$(jq length "$Tmp/chat_tool_calls")
    for i in $(seq 0 $((n - 1))); do

        # prepare input
        jq ".[$i].function.arguments|fromjson" "$Tmp/chat_tool_calls" > "$Tmp/chat_tool_args"
        eval "$(jq -r "$JQLIB"".[$i]|{name:.function.name,id}|shassign" "$Tmp/chat_tool_calls")"

        # call
        case "$name" in
            (get_time) tool_get_date ;;
            (read) tool_read ;;
            (write) tool_write ;;
            (edit) tool_edit ;;
            (bash) tool_bash ;;
            (read_image) tool_read_image ;;
            (*) error "unknown tool: $name" ;;
        esac | stdbuf -i0 -o0 tee "$Tmp/chat_tool_out"

        # add response
        jq -Rsc --arg id "$id" '{role:"tool",tool_call_id:$id,content:.}' "$Tmp/chat_tool_out" >> "$SessionFile"

    done
    echo -e "\e[0m"
}

# Usage: bwrap_recurse CMD [ARGS ...]
bwrap_recurse(){
    bwrap --ro-bind / / --dev-bind /dev /dev --bind "${TMPDIR:-/tmp}" "${TMPDIR:-/tmp}" --bind "$PWD" "$PWD" --bind "$DATADIR" "$DATADIR" --setenv BWRAP 1 "$@"
}

# Main

main(){
    local inputfiles=()
    parse_opts "$@"
    [[ "$flag_h" ]] && { show_help; exit 0; }
    mkdir -p "$DATADIR"
    [[ "$flag_b" && ! "$BWRAP" ]] && { bwrap_recurse "$0" "$@"; exit; }
    init
    if [[ "$flag_l" ]]; then
        show_models
    else
        build_prompt >> "$SessionFile"
        # build_prompt; exit
        if [[ "$flag_n" || ! -r "$HistoryFile" ]]; then inputfiles=("$SessionFile"); else inputfiles=("$HistoryFile" "$SessionFile"); fi
        while :; do
            call_llm "$Tmp/chat_sse" "${inputfiles[@]}"
            # parse_sse_message "$Tmp/chat_sse"; exit
            [[ -f "$Tmp/chat_sse" ]] || error "aborted"
            parse_sse_message "$Tmp/chat_sse" | tee -a "$SessionFile" | jq '.tool_calls' > "$Tmp/chat_tool_calls"
            [[ "$flag_a" && "$(jq length "$Tmp/chat_tool_calls")" -ge 1 ]] || break
            call_tool
        done
        parse_sse_meta "$Tmp/chat_sse" | jq -r "$JQLIB"'"\n\u001b['"$COLOR_STAT"'mSTAT: Model=\(.model), \(.timings|"PP=\(.prompt_per_second|r2)(\(.prompt_n)(\(.cache_n+.prompt_n))/\(.prompt_ms/1000|r2)), TG=\(.predicted_per_second|r2)(\(.predicted_n)/\(.predicted_ms/1000|r2))")"' >&2
        save_history
    fi
}

main "$@"
