#!/bin/awk -f

# Usage:
#     ./mystatus

BEGIN {
    DIR_BACKLIGHT = get_env("MYSTATUS_DIR_BACKLIGHT", "/sys/class/backlight/intel_backlight/")
    DIR_THERMAL   = get_env("MYSTATUS_DIR_THERMAL",   "/sys/class/thermal/thermal_zone0/")
    DIR_POWER_BAT = get_env("MYSTATUS_DIR_POWER_BAT", "/sys/class/power_supply/BAT0")
    DIR_POWER_AC  = get_env("MYSTATUS_DIR_POWER_AC",  "/sys/class/power_supply/AC")
    MAX_WIDTH     = get_env("MYSTATUS_MAX_WIDTH", "99999")
    CACHE_STAT    = get_env("TMPDIR", "/tmp") "/mystatus_statold"

    o_cpu       = get_cpu()
    o_datetime  = get_datetime()
    o_backlight = get_backlight()
    o_volume    = get_volume()
    o_thermal   = get_thermal()
    o_power     = get_power()
    o_memory    = get_memory()

    split(o_datetime, o_date_day_time, ",")

    max_width_eval = sum_split_nums(MAX_WIDTH)

    if (error) {
        printf "%s\n", error
    } else {
        # printf "%s  B %s%%  V %s  T %sC  P %s\n", o_datetime, o_backlight, o_volume, o_thermal, o_power
        # printf "%s  B %s%%  V %s  T %sC  C %s  M %s  P %s\n", o_datetime, o_backlight, o_volume, o_thermal, o_cpu, o_memory, o_power

        i = 0
        # info priority highest to lowest
        # spec[i*2-1] = print position
        # spec[i*2]   = string at the position
        i++; spec[i*2-1] = 7; spec[i*2] = "P " o_power " "
        i++; spec[i*2-1] = 3; spec[i*2] = o_date_day_time[3] " "
        i++; spec[i*2-1] = 5; spec[i*2] = "V " o_volume "  "
        i++; spec[i*2-1] = 1; spec[i*2] = " " o_date_day_time[1] " "
        i++; spec[i*2-1] = 2; spec[i*2] = o_date_day_time[2] " "
        i++; spec[i*2-1] = 4; spec[i*2] = "B " o_backlight "%  "
        i++; spec[i*2-1] = 6; spec[i*2] = "T " o_thermal "C  "
        print print_w(max_width_eval, spec)
    }

    exit
}

function get_env(var, fallback) {
    return (length(ENVIRON[var]) > 0) ? ENVIRON[var] : fallback
}

function get_cpu(    line, ncpu, stat1, stat2, a, b) {
    getline stat1 < "/proc/stat"
    while ((getline line < "/proc/stat") == 1) {
        if (line ~ /^cpu[0-9]+/) {
            ncpu++
        }
    }
    getline stat2 < CACHE_STAT
    print stat1 > CACHE_STAT
    if (split(stat2, b) >= 5 && split(stat1, a) >= 5) {
        return int(100 * ((a[2]+a[4])-(b[2]+b[4]))/((a[2]+a[4]+a[5])-(b[2]+b[4]+b[5]))) "%:" ncpu "c"
    } else {
        return "?"
    }
}

function get_backlight(    cur, max, val) {
    getline cur < (DIR_BACKLIGHT "/brightness") # paren necessary
    getline max < (DIR_BACKLIGHT "/max_brightness")
    val = log(cur>0?cur:1)/log(max)
    val = (val*val*val)*100
    return int(val)
}

function get_datetime(    val) {
    "date +'%Y-%m-%d (%a) %H:%M'" | getline val
    return val
}

function get_volume(    val) {
    if (("pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null" | getline val) != 1) return "?"
    sub("%.*", "", val)
    sub(".* ", "", val)
    return val "%"
}

function get_thermal(    val) {
    getline val < (DIR_THERMAL "/temp")
    return val / 1000
}

function get_power(    capacity, charging) {
    if ((getline capacity < (DIR_POWER_BAT "/capacity")) != 1) return "?";
    if ((getline charging < (DIR_POWER_AC "/online")) != 1) return "?";
    if (capacity < 10 && !charging) error = "Battery low: " capacity "%";
    return capacity "%" (charging ? "+" : "")
}

function get_memory(    line, total, avail, used) {
    while ((getline line < "/proc/meminfo") == 1) {
        if (line ~ /^MemTotal:/) {
            total = line
        } else if (line ~ /^MemAvailable:/) {
            avail = line
        }
        if (total && avail) {
            break
        }
    }
    gsub("[^0-9]*", "", total)
    gsub("[^0-9]*", "", avail)
    used  = total - avail
    # total = int(total / 100000) / 10
    # avail = int(avail / 100000) / 10
    # used  = int(used  / 100000) / 10
    total = int(((total / 100000) + 5) / 10) # round at GB
    used  = int(((used  / 100000) + 5) / 10) # round at GB
    return used "/" total "GB"
}

function sum_split_nums(str,    sp, sum) {
    split(str, sp, ",")
    sum = 0
    for (i in sp)
        sum += int(sp[i])
    return sum
}

function print_w(cmax, spec,    nspec, c, i, a, out) {
    nspec = length(spec)
    c = 0
    i = 1
    while (i <= nspec && (c + length(spec[i*2]) <= cmax)) {
        a[spec[i*2-1]] = i
        c += length(spec[i*2])
        i++;
    }
    out = ""
    for (i=1; i<=nspec; i++)
        if (a[i])
            out = out spec[a[i]*2]
    return out
}
